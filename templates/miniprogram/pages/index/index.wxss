page {
  background-color: #f1f5f9;
  color: #0f172a;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

.container {
  padding: 24rpx;
}

/* Section 1: Header Bar */
.header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.page-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #0f172a;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.top-btn {
  font-size: 22rpx;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 16rpx;
  margin: 0;
  border-radius: 8rpx;
  color: white;
}

.btn-search {
  background-color: #2563eb;
}

.btn-dfu {
  background-color: #475569;
}

.badge-authorized {
  font-size: 20rpx;
  font-weight: bold;
  color: #16a34a;
  background-color: #dcfce7;
  border: 1rpx solid #86efac;
  padding: 6rpx 12rpx;
  border-radius: 6rpx;
}

/* Base Card Style */
.card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  font-weight: bold;
  color: #1e293b;
  margin-bottom: 6rpx;
}

.card-title-icon {
  margin-right: 8rpx;
}

.card-subtitle {
  font-size: 22rpx;
  color: #64748b;
  margin-bottom: 16rpx;
}

/* Status Card */
.status-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.status-left {
  display: flex;
  align-items: center;
}

.status-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.dot-green {
  background-color: #22c55e;
}

.dot-red {
  background-color: #ef4444;
}

.status-text {
  font-size: 26rpx;
  font-weight: bold;
}

.text-green {
  color: #16a34a;
}

.text-red {
  color: #dc2626;
}

.battery-capsule {
  display: flex;
  align-items: center;
  background-color: #dcfce7;
  border: 1rpx solid #86efac;
  border-radius: 20rpx;
  padding: 4rpx 14rpx;
}

.battery-icon {
  font-size: 22rpx;
  margin-right: 4rpx;
}

.battery-val {
  font-size: 22rpx;
  font-weight: bold;
  color: #16a34a;
}

.device-name {
  font-size: 34rpx;
  font-weight: bold;
  color: #0f172a;
  margin-top: 14rpx;
}

.device-meta {
  font-size: 22rpx;
  color: #64748b;
  margin-top: 6rpx;
  margin-bottom: 14rpx;
}

.badge-group {
  display: flex;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.chip-badge {
  font-size: 20rpx;
  font-weight: 600;
  padding: 6rpx 14rpx;
  border-radius: 6rpx;
}

.chip-blue {
  background-color: rgba(2, 132, 199, 0.12);
  color: #0284c7;
  border: 1rpx solid rgba(2, 132, 199, 0.4);
}

.chip-teal {
  background-color: rgba(13, 148, 136, 0.12);
  color: #0d9488;
  border: 1rpx solid rgba(13, 148, 136, 0.4);
}

.chip-purple {
  background-color: rgba(124, 58, 237, 0.12);
  color: #7c3aed;
  border: 1rpx solid rgba(124, 58, 237, 0.4);
}

.btn-primary {
  width: 100%;
  height: 68rpx;
  line-height: 68rpx;
  font-size: 26rpx;
  font-weight: bold;
  color: white;
  border-radius: 12rpx;
}

.btn-connect {
  background-color: #2563eb;
}

.btn-danger {
  background-color: #dc2626;
}

/* Channel Settings */
.channel-row {
  margin-top: 10rpx;
}

.checkbox-label {
  margin-right: 32rpx;
  font-size: 26rpx;
}

.checkbox-label.disabled {
  color: #94a3b8;
}

/* Chart Chips Grid */
.chart-chips-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 10rpx;
}

.chart-chip {
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  background-color: #f1f5f9;
  color: #334155;
  border: 1rpx solid #e2e8f0;
}

.chart-chip.chip-active {
  background-color: #2563eb;
  color: white;
  border-color: #2563eb;
}

/* Action Button Grid */
.btn-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.action-btn {
  font-size: 22rpx;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 16rpx;
  margin: 0;
  border-radius: 8rpx;
  border-width: 1rpx;
  border-style: solid;
}

.btn-green {
  background-color: rgba(22, 163, 74, 0.12);
  color: #16a34a;
  border-color: rgba(22, 163, 74, 0.4);
}

.btn-red {
  background-color: rgba(220, 38, 38, 0.12);
  color: #dc2626;
  border-color: rgba(220, 38, 38, 0.4);
}

.btn-blue {
  background-color: rgba(2, 132, 199, 0.12);
  color: #0284c7;
  border-color: rgba(2, 132, 199, 0.4);
}

.btn-orange {
  background-color: rgba(217, 119, 6, 0.12);
  color: #d97706;
  border-color: rgba(217, 119, 6, 0.4);
}

.btn-gray {
  background-color: rgba(71, 85, 105, 0.1);
  color: #475569;
  border-color: rgba(71, 85, 105, 0.3);
}

.btn-teal {
  background-color: rgba(13, 148, 136, 0.12);
  color: #0d9488;
  border-color: rgba(13, 148, 136, 0.4);
}

.btn-purple {
  background-color: rgba(124, 58, 237, 0.12);
  color: #7c3aed;
  border-color: rgba(124, 58, 237, 0.4);
}

/* Inputs & Actions */
.sn-input-row, .cmd-input-row {
  display: flex;
  gap: 12rpx;
  margin-top: 10rpx;
}

.mini-input {
  flex: 1;
  height: 64rpx;
  background-color: #f8fafc;
  border: 1rpx solid #cbd5e1;
  border-radius: 8rpx;
  padding: 0 16rpx;
  font-size: 24rpx;
}

.btn-sn {
  font-size: 22rpx;
  height: 64rpx;
  line-height: 64rpx;
  background-color: #0f172a;
  color: white;
  padding: 0 20rpx;
  margin: 0;
  border-radius: 8rpx;
}

.btn-send-cmd {
  font-size: 22rpx;
  height: 64rpx;
  line-height: 64rpx;
  background-color: #2563eb;
  color: white;
  padding: 0 24rpx;
  margin: 0;
  border-radius: 8rpx;
}

/* MEMS Posture Card */
.mems-box {
  background-color: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 10rpx;
  padding: 16rpx;
  margin-bottom: 16rpx;
}

.mems-header {
  font-size: 24rpx;
  font-weight: bold;
  color: #334155;
  margin-bottom: 8rpx;
}

.mems-text {
  font-family: monospace;
  font-size: 22rpx;
  color: #1e293b;
  line-height: 1.5;
}

.text-dim {
  color: #64748b;
}

/* Terminal Monitor */
.terminal-box {
  background-color: #0f172a;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-top: 16rpx;
}

.terminal-header {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #94a3b8;
  margin-bottom: 10rpx;
}

.btn-clear {
  color: #38bdf8;
}

.terminal-logs {
  height: 180rpx;
  font-family: monospace;
  font-size: 20rpx;
  color: #4ade80;
  line-height: 1.4;
}

/* Section 7: DeviceShowTable 4x3 Spectrum Grid */
.table-mac-header {
  background-color: #1e293b;
  color: white;
  text-align: center;
  font-family: monospace;
  font-size: 24rpx;
  font-weight: bold;
  padding: 12rpx 0;
  border-radius: 8rpx;
  margin-bottom: 12rpx;
}

.table-container {
  border: 1rpx solid #cbd5e1;
  border-radius: 4rpx;
  overflow: hidden;
}

.table-row {
  display: flex;
  border-bottom: 1rpx solid #cbd5e1;
}

.table-row:last-child {
  border-bottom: none;
}

.table-cell {
  flex: 1;
  padding: 14rpx 6rpx;
  text-align: center;
  border-right: 1rpx solid #cbd5e1;
}

.table-cell:last-child {
  border-right: none;
}

.cell-label {
  font-size: 20rpx;
  font-weight: bold;
  color: #334155;
  margin-bottom: 4rpx;
}

.cell-val {
  font-family: monospace;
  font-size: 24rpx;
  font-weight: bold;
  color: #0f172a;
}

/* 3-Color Definitions */
.bg-pink {
  background-color: #ffe4e1;
}

.bg-cyan {
  background-color: #e0ffff;
}

.bg-yellow {
  background-color: #f0e68c;
}

/* Section 8: Modal Dialog */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-content {
  width: 88%;
  background-color: white;
  border-radius: 16rpx;
  padding: 28rpx;
  box-sizing: border-box;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.modal-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #1e293b;
}

.modal-close {
  font-size: 32rpx;
  color: #64748b;
  padding: 8rpx;
}

.modal-status {
  font-size: 22rpx;
  color: #64748b;
  margin-bottom: 16rpx;
}

.device-list {
  max-height: 480rpx;
  margin-bottom: 16rpx;
}

.device-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx;
  background-color: #f8fafc;
  border-radius: 10rpx;
  margin-bottom: 12rpx;
}

.device-info {
  display: flex;
  flex-direction: column;
}

.item-name {
  font-size: 26rpx;
  font-weight: bold;
  color: #0f172a;
}

.item-mac {
  font-size: 20rpx;
  color: #64748b;
  margin-top: 4rpx;
}

.btn-item-connect {
  font-size: 22rpx;
  height: 52rpx;
  line-height: 52rpx;
  background-color: #16a34a;
  color: white;
  padding: 0 18rpx;
  margin: 0;
  border-radius: 8rpx;
}

.empty-tip {
  text-align: center;
  font-size: 24rpx;
  color: #94a3b8;
  padding: 40rpx 0;
}

.btn-rescan {
  width: 100%;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 24rpx;
  background-color: #2563eb;
  color: white;
  border-radius: 8rpx;
}
