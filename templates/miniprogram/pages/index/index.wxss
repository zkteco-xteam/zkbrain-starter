page { background-color: #0f172a; color: #f8fafc; font-family: -apple-system, BlinkMacSystemFont, sans-serif; }
.container { padding: 32rpx; }
.card { background-color: #1e293b; border-radius: 16rpx; padding: 32rpx; margin-bottom: 32rpx; }
.status-row { display: flex; align-items: center; margin-bottom: 24rpx; }
.dot { width: 20rpx; height: 20rpx; border-radius: 50%; margin-right: 16rpx; }
.dot.green { background-color: #22c55e; }
.dot.orange { background-color: #f97316; }
.status-title { font-size: 32rpx; font-weight: bold; }
.btn { background-color: #3b82f6; color: white; border-radius: 12rpx; font-size: 28rpx; width: 100%; }
.metric-title { font-size: 34rpx; font-weight: bold; margin-bottom: 24rpx; }
.metric-item { display: flex; justify-content: space-between; font-size: 28rpx; margin-bottom: 12rpx; }
.metric-val { font-weight: bold; }
.text-blue { color: #60a5fa; }
.text-green { color: #4ade80; }
.signal-tag { margin-top: 24rpx; font-size: 24rpx; color: #94a3b8; }
