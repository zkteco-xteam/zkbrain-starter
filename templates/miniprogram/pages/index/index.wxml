<view class="container">
  <!-- 1. 连接状态卡片 -->
  <view class="card">
    <view class="status-row">
      <view class="dot {{isConnected ? 'green' : 'orange'}}"></view>
      <text class="status-title">{{statusText}}</text>
    </view>
    <button class="btn" bindtap="toggleScan">{{isScanning ? '正在搜索...' : '搜索并连接脑电设备'}}</button>
  </view>

  <!-- 2. 生理指标仪表 -->
  <view class="card">
    <view class="metric-title">实时脑波指标 (1Hz)</view>
    
    <view class="metric-item">
      <text>专注度 (Attention)</text>
      <text class="metric-val text-blue">{{attention}} / 100</text>
    </view>
    <progress percent="{{attention}}" stroke-width="8" activeColor="#3b82f6" backgroundColor="#334155" border-radius="4" />

    <view class="metric-item" style="margin-top: 24rpx;">
      <text>放松度 (Meditation)</text>
      <text class="metric-val text-green">{{meditation}} / 100</text>
    </view>
    <progress percent="{{meditation}}" stroke-width="8" activeColor="#22c55e" backgroundColor="#334155" border-radius="4" />

    <view class="signal-tag">
      <text>电极接触状态: {{poorSignal === 0 ? '🟢 接触良好' : '🔴 接触不良或脱落'}}</text>
    </view>
  </view>

  <!-- 3. 脑电 8 频段功率谱能量分布 -->
  <view class="card">
    <view class="metric-title">8 频段脑电功率谱能量 (Band Powers)</view>
    <view class="band-grid">
      <view class="band-item"><text class="band-name text-indigo">Delta (深度睡眠):</text><text class="band-val">{{waves.delta}}</text></view>
      <view class="band-item"><text class="band-name text-cyan">Theta (潜意识):</text><text class="band-val">{{waves.theta}}</text></view>
      <view class="band-item"><text class="band-name text-teal">Low Alpha (闭目放松):</text><text class="band-val">{{waves.lowAlpha}}</text></view>
      <view class="band-item"><text class="band-name text-emerald">High Alpha (静定心流):</text><text class="band-val">{{waves.highAlpha}}</text></view>
      <view class="band-item"><text class="band-name text-amber">Low Beta (轻度专注):</text><text class="band-val">{{waves.lowBeta}}</text></view>
      <view class="band-item"><text class="band-name text-orange">High Beta (计算紧张):</text><text class="band-val">{{waves.highBeta}}</text></view>
      <view class="band-item"><text class="band-name text-rose">Low Gamma (认知加工):</text><text class="band-val">{{waves.lowGamma}}</text></view>
      <view class="band-item"><text class="band-name text-pink">Mid Gamma (多感官整合):</text><text class="band-val">{{waves.middleGamma}}</text></view>
    </view>
  </view>

  <!-- 4. 硬件指令下发与 MEMS 控制台 (遵循《硬件协议集成指南》) -->
  <view class="card">
    <view class="metric-title">🛠️ 硬件指令下发与 MEMS 控制台</view>
    
    <view class="sub-group-title text-cyan">1. ZKTeco (自研脑电/MEMS) ASCII 协议:</view>
    <view class="preset-buttons">
      <button class="sub-btn" bindtap="handleMemsOn">开启 MEMS (mems_on:1)</button>
      <button class="sub-btn" bindtap="handleMemsOff">关闭 MEMS (mems_on:0)</button>
      <button class="sub-btn" bindtap="handleRate512">512Hz采样率</button>
      <button class="sub-btn" bindtap="handleBatteryZk">查电量 (battery:?)</button>
    </view>

    <view class="sub-group-title text-orange">2. Sky (NeuroSky/MindWave) XMW 二进制协议:</view>
    <view class="preset-buttons">
      <button class="sub-btn" bindtap="handleIgnition">点火 (0x15/0x17)</button>
      <button class="sub-btn" bindtap="handle50Hz">50Hz工频滤波 (0x1B)</button>
      <button class="sub-btn" bindtap="handleBatterySky">查电量 (0x06)</button>
    </view>

    <view class="input-row">
      <input class="cmd-input" value="{{commandInput}}" bindinput="onCommandInput" placeholder="输入键值对 (如 mems_on:1) 或指令" />
      <button class="send-btn" bindtap="handleSendCommand">下发</button>
    </view>
    <view class="log-label">指令收发终端交互日志:</view>
    <scroll-view scroll-y class="log-box">
      <text>{{commandLogs}}</text>
    </scroll-view>
  </view>
</view>
