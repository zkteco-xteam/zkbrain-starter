<!-- 1:1 DeviceScreen & DeviceShowTable Clone - WeChat Mini Program Edition -->
<view class="container">
  <!-- Section 1: Header Actions -->
  <view class="header-bar">
    <text class="page-title">Device Management</text>
    <view class="header-actions">
      <button class="top-btn btn-search" bindtap="openScanModal">🔍 Search</button>
      <button class="top-btn btn-dfu" bindtap="handleDfuUpgrade">🚀 DFU Upgrade</button>
      <view class="badge-authorized">Authorized</view>
    </view>
  </view>

  <!-- Section 2: Unified Device Status Card -->
  <view class="card">
    <view class="status-header">
      <view class="status-left">
        <view class="status-dot {{isConnected ? 'dot-green' : 'dot-red'}}"></view>
        <text class="status-text {{isConnected ? 'text-green' : 'text-red'}}">{{connectionStatusText}}</text>
      </view>
      <view class="battery-capsule">
        <text class="battery-icon">🔋</text>
        <text class="battery-val">{{batteryLevel}}%</text>
      </view>
    </view>

    <view class="device-name">{{deviceName}}</view>
    <view class="device-meta">MAC: {{deviceMac}}  |  SN: ZK-2026-DEV001</view>

    <view class="badge-group">
      <view class="chip-badge chip-blue">ZKBrain Core</view>
      <view class="chip-badge chip-teal">Single-Ch (FP1)</view>
      <view class="chip-badge chip-purple">ASCII + MEMS</view>
    </view>

    <button class="btn-primary {{isConnected ? 'btn-danger' : 'btn-connect'}}" bindtap="toggleConnect">
      {{isConnected ? 'Disconnect' : 'Scan & Connect'}}
    </button>
  </view>

  <!-- Section 3: Channel Settings Card -->
  <view class="card">
    <view class="card-title">
      <text class="card-title-icon">⚙️</text>
      <text>Channel Settings</text>
    </view>
    <view class="channel-row">
      <checkbox-group bindchange="onChannelChange">
        <label class="checkbox-label">
          <checkbox value="fp1" checked="{{isFp1Checked}}" color="#2563eb" />
          <text>Left (FP1)</text>
        </label>
        <label class="checkbox-label disabled">
          <checkbox value="fp2" disabled color="#94a3b8" />
          <text>Right (FP2) [Unsupported]</text>
        </label>
      </checkbox-group>
    </view>
  </view>

  <!-- Section 4: Chart Display Settings Card -->
  <view class="card">
    <view class="card-title">
      <text class="card-title-icon">📈</text>
      <text>Chart Display Settings</text>
    </view>
    <view class="chart-chips-grid">
      <view 
        wx:for="{{chartToggles}}" 
        wx:key="key" 
        class="chart-chip {{item.checked ? 'chip-active' : ''}}"
        bindtap="toggleChartItem"
        data-key="{{item.key}}"
      >
        {{item.key}}
      </view>
    </view>
  </view>

  <!-- Section 5: NeuroSky / MindWave Protocol Console -->
  <view class="card">
    <view class="card-title">
      <text class="card-title-icon">⚙️</text>
      <text>NeuroSky / MindWave Protocol Console</text>
    </view>
    <view class="card-subtitle">Supports 20-byte binary ignition frame, notch filter, SN read/write and classic MAC probing</view>
    
    <view class="btn-grid">
      <button class="action-btn btn-green" bindtap="handleIgnition">🚀 Ignition (0x15/17)</button>
      <button class="action-btn btn-red" bindtap="handleStopXmw">🛑 Stop (0x16/18)</button>
      <button class="action-btn btn-gray" bindtap="handleFilter50">50Hz Notch (0x1B)</button>
      <button class="action-btn btn-gray" bindtap="handleFilter60">60Hz Notch (0x1C)</button>
      <button class="action-btn btn-orange" bindtap="handleBatterySky">Battery (0x06)</button>
      <button class="action-btn btn-orange" bindtap="handleReadSn">Serial SN (0xF4)</button>
      <button class="action-btn btn-purple" bindtap="handleDetectMac">Classic MAC (0xFC)</button>
    </view>

    <view class="sn-input-row">
      <input class="mini-input" value="{{writeSnInput}}" bindinput="onWriteSnInput" placeholder="Enter serial number SN..." />
      <button class="btn-sn" bindtap="handleWriteSn">Write SN (0xF2)</button>
    </view>
  </view>

  <!-- Section 6: ZKBrain Proprietary Device Console -->
  <view class="card">
    <view class="card-title">
      <text class="card-title-icon">🧠</text>
      <text>ZKBrain Proprietary Device Console</text>
    </view>
    <view class="card-subtitle">Supports ASCII control, MEMS posture sensing, sample rate switching and terminal monitor</view>

    <view class="btn-grid">
      <button class="action-btn btn-blue" bindtap="handleLicenseQuery">License</button>
      <button class="action-btn btn-blue" bindtap="handleBatteryQuery">Battery</button>
      <button class="action-btn btn-blue" bindtap="handleVersionQuery">Version</button>
      <button class="action-btn btn-green" bindtap="handleEegOn">Start EEG</button>
      <button class="action-btn btn-red" bindtap="handleEegOff">Stop EEG</button>
      <button class="action-btn btn-gray" bindtap="handleRate256">256Hz Rate</button>
      <button class="action-btn btn-gray" bindtap="handleRate512">512Hz Rate</button>
      <button class="action-btn btn-teal" bindtap="handleMemsOn">Start MEMS</button>
      <button class="action-btn btn-gray" bindtap="handleMemsOff">Stop MEMS</button>
      <button class="action-btn btn-purple" bindtap="handleDfuScan">DFU Scan</button>
    </view>

    <view class="mems-box">
      <view class="mems-header">📐 Realtime MEMS Posture (Euler & Quaternion)</view>
      <view class="mems-text">Euler:  Roll: {{memsRoll}}°   Pitch: {{memsPitch}}°   Yaw: {{memsYaw}}°</view>
      <view class="mems-text text-dim">Quat:   Q0: {{memsQ0}}  Q1: {{memsQ1}}  Q2: {{memsQ2}}  Q3: {{memsQ3}}</view>
    </view>

    <view class="cmd-input-row">
      <input class="mini-input" value="{{customCmdInput}}" bindinput="onCustomCmdInput" placeholder="Custom command (e.g. mems_on:1)" />
      <button class="btn-send-cmd" bindtap="handleSendCustomCmd">Send</button>
    </view>

    <view class="terminal-box">
      <view class="terminal-header">
        <text>Terminal Monitor:</text>
        <text class="btn-clear" bindtap="clearLogs">Clear</text>
      </view>
      <scroll-view scroll-y class="terminal-logs">
        <text>{{commandLogs}}</text>
      </scroll-view>
    </view>
  </view>

  <!-- Section 7: Spectrum Data Table (DeviceShowTable 4x3) -->
  <view class="card">
    <view class="table-mac-header">Device MAC: {{deviceMac}}</view>

    <view class="table-container">
      <view class="table-row">
        <view class="table-cell bg-pink">
          <view class="cell-label">Attention</view>
          <view class="cell-val">{{attention}}</view>
        </view>
        <view class="table-cell bg-pink">
          <view class="cell-label">Meditation</view>
          <view class="cell-val">{{meditation}}</view>
        </view>
        <view class="table-cell bg-pink">
          <view class="cell-label">Quality</view>
          <view class="cell-val">{{signalQuality}}</view>
        </view>
      </view>

      <view class="table-row">
        <view class="table-cell bg-pink">
          <view class="cell-label">Raw EEG</view>
          <view class="cell-val">{{rawEeg}}</view>
        </view>
        <view class="table-cell bg-cyan">
          <view class="cell-label">Delta</view>
          <view class="cell-val">{{waves.delta}}</view>
        </view>
        <view class="table-cell bg-cyan">
          <view class="cell-label">Theta</view>
          <view class="cell-val">{{waves.theta}}</view>
        </view>
      </view>

      <view class="table-row">
        <view class="table-cell bg-cyan">
          <view class="cell-label">Low Alpha</view>
          <view class="cell-val">{{waves.lowAlpha}}</view>
        </view>
        <view class="table-cell bg-cyan">
          <view class="cell-label">High Alpha</view>
          <view class="cell-val">{{waves.highAlpha}}</view>
        </view>
        <view class="table-cell bg-yellow">
          <view class="cell-label">Low Beta</view>
          <view class="cell-val">{{waves.lowBeta}}</view>
        </view>
      </view>

      <view class="table-row">
        <view class="table-cell bg-yellow">
          <view class="cell-label">High Beta</view>
          <view class="cell-val">{{waves.highBeta}}</view>
        </view>
        <view class="table-cell bg-yellow">
          <view class="cell-label">Low Gamma</view>
          <view class="cell-val">{{waves.lowGamma}}</view>
        </view>
        <view class="table-cell bg-yellow">
          <view class="cell-label">Mid Gamma</view>
          <view class="cell-val">{{waves.middleGamma}}</view>
        </view>
      </view>
    </view>
  </view>

  <view style="height: 48rpx;"></view>

  <!-- Section 8: Bluetooth Scan Modal (BleScanModal) -->
  <view class="modal-mask" wx:if="{{showScanModal}}" bindtap="closeScanModal">
    <view class="modal-content" catchtap="stopBubble">
      <view class="modal-header">
        <text class="modal-title">🔍 Search Nearby BCI Devices</text>
        <view class="modal-close" bindtap="closeScanModal">✕</view>
      </view>
      <view class="modal-status">{{isScanning ? 'Scanning for nearby BLE BCI devices...' : 'Scan completed'}}</view>

      <scroll-view scroll-y class="device-list">
        <view class="device-item" wx:for="{{scannedDevices}}" wx:key="mac">
          <view class="device-info">
            <text class="item-name">{{item.name}}</text>
            <text class="item-mac">{{item.mac}} | RSSI: {{item.rssi}} dBm</text>
          </view>
          <button class="btn-item-connect" bindtap="connectScannedDevice" data-item="{{item}}">Connect</button>
        </view>
        <view class="empty-tip" wx:if="{{scannedDevices.length === 0}}">
          No BCI devices found. Please ensure device is powered on.
        </view>
      </scroll-view>

      <button class="btn-rescan" bindtap="startScan">{{isScanning ? 'Scanning...' : 'Rescan'}}</button>
    </view>
  </view>
</view>
