<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Windows 10/11 Native WinRT BLE API Support -->
    <TargetFramework>net6.0-windows10.0.19041.0</TargetFramework>
    <Nullable>disable</Nullable>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>ZKBrainDemo</AssemblyName>
    <RootNamespace>ZKBrain.Windows.Demo</RootNamespace>
  </PropertyGroup>

  <!-- Auto-copy 64-bit Core DLL and universal license to output directory -->
  <ItemGroup>
    <None Include="..\..\bin\x64\zkbrain_sec.dll" Link="zkbrain_sec.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\license.lic" Link="license.lic">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
